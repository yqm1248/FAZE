{
  "name": "faze-mobile-app",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "description": "法泽 APP —— 普惠型法律服务平台（Expo / React Native，段 0：可安装底座 + 三项探针）",
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit && eslint .",
    "lint:fix": "eslint . --fix",
    "check:rawtext": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../scripts/check-raw-text.ps1",
    "check:i18n": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../scripts/check-i18n.ps1",
    "verify": "npm run typecheck && eslint . && npm run check:rawtext && npm run check:i18n"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.3",
    "expo": "~54.0.0",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.14",
    "expo-dev-client": "~6.0.21",
    "expo-document-picker": "~14.0.8",
    "expo-font": "~14.0.12",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-localization": "~17.0.9",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.20",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "~19.1.0",
    "babel-preset-expo": "~54.0.10",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.72.0"
  }
}
