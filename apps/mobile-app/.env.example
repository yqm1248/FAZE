# 法泽 APP 环境变量示例（复制为 .env 后填写；.env 已在 .gitignore）
#
# ⚠️ EXPO_PUBLIC_* 会被 Expo 在构建期内联进客户端产物，**任何人都能在包里读到**。
#    所以这里只放地址，绝不放密钥（JWT 密钥只在服务端）。

# ── 服务端地址 ─────────────────────────────────────────────
# ⚠️ 真机必须用 PC 的局域网 IPv4（ipconfig 取），**不能用 localhost**（指向手机自己），
#    也不能用 10.0.2.2（那是 Android 模拟器专用别名）。
#    填错的表现是「App 一直网络错误」，且日志里看不到原因。
#    验收前置：手机浏览器能打开 http://<PC-IP>:8081/api/v1/pub/ping
#    Windows 防火墙要放行 8081。
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.100:8081

# ── 探针路由开关 ───────────────────────────────────────────
# ⚠️ 生产构建必须为 false。为 true 时 /dev/probe 与 /dev/rtl 会在非 dev 包里也可访问，
#    而 /dev/probe 会真实消耗豆包配额（服务端探针本身在 prod profile 下已 404）。
EXPO_PUBLIC_ENABLE_DEV_ROUTES=false

# ── EAS（D1 构建 APK 时填）─────────────────────────────────
# ⚠️ 留空时 `extra.eas.projectId` 为空串，EAS 构建会提示未关联项目；
#    本地 `npx expo start` 不需要它。
EAS_PROJECT_ID=
