# 依赖
node_modules/
.pnpm-store/

# Expo / Metro
.expo/
.expo-shared/
dist/
web-build/
*.tsbuildinfo
# Vite 依赖预构建缓存（`npx vite build` / dev 都会在包目录下生成）
.vite/

# 原生构建产物
android/
ios/
*.apk
*.aab
*.ipa
*.keystore
*.jks

# Java / Maven 构建产物（第 0 段 A1 追加；不加 *.jar 全局忽略，避免误伤将来的 libs/*.jar）
target/
*.class

# 环境与密钥
.env
.env.*
!.env.example
# 例外：PC 后台的三个 .env 必须入库。
# 为什么：RuoYi-Vue3 的 .env.development / .env.production / .env.staging 里定义
#   VITE_APP_TITLE（侧边栏与浏览器标签页标题）和 VITE_APP_BASE_API（接口前缀），
#   被上面两条规则一起忽略后，clone 下来的仓库根本没有这三个文件——
#   实测 2026-11-13 时 git ls-files 查不到它们，dev server 的接口前缀会变成 undefined。
#   这三个文件只含标题、环境名、API 前缀和压缩开关，不含任何密钥，可以入库。
# 注意：apps/mobile-app/.env 仍然保持忽略——它装的是每台机器各自的局域网 API 地址。
!pc/admin-web/.env.development
!pc/admin-web/.env.production
!pc/admin-web/.env.staging

# 运行日志与临时输出
logs/
runtime/
tmp/
*.log
# 例外：验收证据必须入库，否则别人 clone 下来看不到「跑过什么、结果如何」。
# 《第1段工作流》H1 要求每条锚点都有证据文件路径，log 属于证据本体。
!docs/acceptance/**/*.log

# 段 8 i18n 预览页的字体副本（2.3 MB，从 apps/mobile-app/assets/fonts/ 复制而来）。
# 只为本机 file:// 预览服务；字体本体已入库，不重复存。
docs/acceptance/seg8/fonts/

# 测试与覆盖率
coverage/
.jest-cache/

# 编辑器与系统
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.DS_Store
Thumbs.db
desktop.ini
