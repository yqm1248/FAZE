# 依赖
node_modules/
.pnpm-store/

# Expo / Metro
.expo/
.expo-shared/
dist/
web-build/
*.tsbuildinfo
# Vite 依赖预构建缓存（`npx vite build` / dev 都会在包目录下生成）
.vite/

# 原生构建产物
android/
ios/
*.apk
*.aab
*.ipa
*.keystore
*.jks

# Java / Maven 构建产物（第 0 段 A1 追加；不加 *.jar 全局忽略，避免误伤将来的 libs/*.jar）
target/
*.class

# 环境与密钥
.env
.env.*
!.env.example

# 运行日志与临时输出
logs/
runtime/
tmp/
*.log
# 例外：验收证据必须入库，否则别人 clone 下来看不到「跑过什么、结果如何」。
# 《第1段工作流》H1 要求每条锚点都有证据文件路径，log 属于证据本体。
!docs/acceptance/**/*.log

# 段 8 i18n 预览页的字体副本（2.3 MB，从 apps/mobile-app/assets/fonts/ 复制而来）。
# 只为本机 file:// 预览服务；字体本体已入库，不重复存。
docs/acceptance/seg8/fonts/

# 测试与覆盖率
coverage/
.jest-cache/

# 编辑器与系统
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.DS_Store
Thumbs.db
desktop.ini
