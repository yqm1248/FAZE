{
  "$schema": "./tokens.schema.json",
  "$meta": {
    "name": "FAZE Design Tokens",
    "version": "1.0.0",
    "description": "法泽 APP 设计令牌唯一来源。配色基线取自原项目首页 pages/index/index.vue，所有页面统一使用本文件，不使用原项目其余 5 套分散配色。",
    "unit": {
      "length": "dp / pt（RN 逻辑像素）",
      "conversionRule": "原 uni-app 使用 rpx，按 750rpx = 375pt 换算，1rpx = 0.5pt",
      "fontSize": "dp"
    },
    "sourceOfTruth": [
      "design/tokens/tokens.json",
      "apps/mobile-app/shared/theme/tokens.ts"
    ]
  },

  "color": {
    "brand": {
      "primary": {
        "value": "#4E6EF2",
        "note": "主色。取自原首页语言切换按钮文字色，用于主按钮、tab 选中态、链接"
      },
      "primaryPressed": {
        "value": "#3D58D6",
        "note": "主色按下态，主色降明度 15%"
      },
      "accent": {
        "value": "#8A2BE2",
        "note": "强调色。取自原首页 AI 解答区块标题，仅用于 AI 相关标题与重点标识"
      },
      "accentSoft": {
        "value": "#F1E9FD",
        "note": "强调色浅底，用于 AI 标签背景"
      },
      "primarySoft": {
        "value": "#EEF2FF",
        "note": "主色浅底。收敛原项目的四处浅蓝底：#eef4ff（起诉状提示条）、#f0f4ff（入驻选中卡）、#eef2ff（资深律师标签）、#f5f7ff（业务擅长标签）"
      }
    },
    "background": {
      "canvas": {
        "value": "#F7F8FA",
        "note": "页面底色。原首页 page 背景色"
      },
      "surface": {
        "value": "#FFFFFF",
        "note": "卡片、面板、底部操作栏底色"
      },
      "input": {
        "value": "#F5F5F5",
        "note": "输入框、模拟搜索框底色"
      }
    },
    "text": {
      "primary": {
        "value": "#1A1A1A",
        "note": "大标题。原首页 slogan"
      },
      "body": {
        "value": "#333333",
        "note": "正文与卡片标题"
      },
      "secondary": {
        "value": "#666666",
        "note": "次要说明文字"
      },
      "muted": {
        "value": "#999999",
        "note": "占位符、meta 信息、tab 未选中态"
      },
      "onBrand": {
        "value": "#FFFFFF",
        "note": "品牌色底上的文字"
      }
    },
    "border": {
      "subtle": {
        "value": "#F0F0F0",
        "note": "功能卡描边"
      },
      "divider": {
        "value": "#F5F5F5",
        "note": "列表分割线"
      },
      "outline": {
        "value": "#EEEEEE",
        "note": "标签描边、次要边框"
      }
    },
    "state": {
      "success": {
        "value": "#2C9696",
        "note": "在线状态、进行中状态。原项目青绿，此处仅作状态色保留，不作为主题色"
      },
      "successSoft": {
        "value": "#EBF5F5",
        "note": "成功状态浅底，对应原 rgba(44,150,150,0.1) 叠白的结果，预先算成实色以遵守禁用 rgba 字面量的规则"
      },
      "warning": {
        "value": "#FF9500",
        "note": "评分星标"
      },
      "danger": {
        "value": "#EE0A24",
        "note": "退出登录、风险操作"
      }
    },
    "banner": {
      "start": {
        "value": "#D2E3FB",
        "note": "首页顶部渐变起点"
      },
      "end": {
        "value": "#F7F8FA",
        "note": "首页顶部渐变终点，与 canvas 衔接"
      }
    },
    "overlay": {
      "whiteSoft": {
        "value": "#FFFFFF38",
        "note": "半透明白，启动页 logo 框底色，对应原 rgba(255,255,255,0.2)；RN 中父容器 opacity 会连带子元素透明，故需要独立的半透明背景色"
      },
      "whiteFaint": {
        "value": "#FFFFFF1A",
        "note": "半透明白，品牌渐变底上的分割线"
      },
      "scrim": {
        "value": "#00000099",
        "note": "遮罩层底色"
      }
    }
  },

  "gradient": {
    "headerBanner": {
      "value": ["#D2E3FB", "#F7F8FA"],
      "direction": "vertical",
      "note": "首页顶部 banner 渐变（to bottom）"
    },
    "avatarRing": {
      "value": ["#FFFFFF", "#F5F7FF"],
      "direction": "vertical",
      "note": "头像描边内衬"
    }
  },

  "fontSize": {
    "h1": { "value": 24, "note": "首页 slogan、登录页主标题（原 48rpx）" },
    "h2": { "value": 17, "note": "页面标题、个人中心用户名候选（原 34rpx）" },
    "h3": { "value": 16, "note": "区块标题 section-title（原 32rpx）" },
    "bodyLarge": { "value": 15, "note": "正文、律师姓名（原 30rpx）" },
    "body": { "value": 14, "note": "列表正文（原 28rpx）" },
    "bodySmall": { "value": 13, "note": "次要说明（原 26rpx）" },
    "caption": { "value": 12, "note": "功能卡文字、标签（原 24rpx）" },
    "micro": { "value": 11, "note": "meta 时间、状态标签（原 22rpx）" }
  },

  "fontWeight": {
    "regular": { "value": "400", "note": "正文" },
    "medium": { "value": "500", "note": "强调正文" },
    "bold": { "value": "700", "note": "标题与按钮" }
  },

  "lineHeight": {
    "tight": { "value": 1.3, "note": "大标题" },
    "normal": { "value": 1.5, "note": "界面文字" },
    "relaxed": { "value": 1.6, "note": "列表正文（原 law-title）" },
    "loose": { "value": 1.8, "note": "长段落与简介（原 intro-content）" }
  },

  "spacing": {
    "xxs": { "value": 2, "note": "原 4rpx" },
    "xs": { "value": 6, "note": "原 12rpx" },
    "sm": { "value": 8, "note": "原 16rpx" },
    "md": { "value": 12, "note": "原 24rpx" },
    "lg": { "value": 15, "note": "原 30rpx，卡片内边距基线" },
    "xl": { "value": 20, "note": "原 40rpx，页面横向边距" },
    "xxl": { "value": 25, "note": "原 50rpx" },
    "xxxl": { "value": 30, "note": "原 60rpx" },
    "huge": { "value": 50, "note": "原 100rpx，顶部刘海安全区预留" }
  },

  "radius": {
    "xs": { "value": 4, "note": "原 8rpx，小标签" },
    "sm": { "value": 6, "note": "原 12rpx，功能卡、搜索框" },
    "md": { "value": 12, "note": "原 24rpx，主卡片" },
    "lg": { "value": 20, "note": "原 40rpx，胶囊按钮" },
    "pill": { "value": 999, "note": "完全圆角，胶囊与圆形头像" }
  },

  "shadow": {
    "card": {
      "value": { "color": "rgba(0,0,0,0.05)", "offsetY": 2, "radius": 10, "elevation": 2 },
      "note": "卡片阴影，原 box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.05)"
    },
    "cardRaised": {
      "value": { "color": "rgba(0,0,0,0.08)", "offsetY": 4, "radius": 12, "elevation": 4 },
      "note": "个人中心用户卡片等更高层级"
    },
    "pill": {
      "value": { "color": "rgba(78,110,242,0.30)", "offsetY": 4, "radius": 10, "elevation": 3 },
      "note": "主色按钮投影"
    }
  },

  "size": {
    "tabBarHeight": { "value": 50, "note": "底部 tab 内容区高度，不含安全区" },
    "tabIconSize": { "value": 24, "note": "沿用原 24px tab 图标；高分屏由矢量替代后放大到 24pt" },
    "navBarHeight": { "value": 44, "note": "自定义导航栏内容高度，不含状态栏" },
    "buttonHeight": { "value": 50, "note": "主按钮高度，原 100rpx" },
    "inputHeight": { "value": 45, "note": "表单输入行高度，原 90rpx" },
    "avatarLarge": { "value": 75, "note": "律师详情头像，原 150rpx" },
    "avatarMedium": { "value": 70, "note": "个人中心头像，原 140rpx" },
    "avatarSmall": { "value": 40, "note": "聊天头像，原 80rpx" },
    "cardIcon": { "value": 30, "note": "功能卡图标，原 60rpx" },
    "listThumbWidth": { "value": 65, "note": "律师卡头像宽，原 130rpx" },
    "listThumbHeight": { "value": 80, "note": "律师卡头像高，原 160rpx" },
    "hairline": { "value": 0.5, "note": "1rpx 发丝线，取 0.5dp" }
  },

  "typography": {
    "fontFamily": {
      "default": {
        "value": "System",
        "note": "中文使用系统字体；原项目未引入可用字体，此处不覆盖"
      }
    }
  }
}
