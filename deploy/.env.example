# ══════════════════════════════════════════════════════════════════
# 法泽 FAZE 本地环境模板（段 0 A2）
# 用法：Copy-Item deploy\.env.example deploy\.env，然后填 FAZE_DB_PASSWORD
# 本文件进仓库；deploy/.env 被 .gitignore 忽略，**绝不入仓库**
# ══════════════════════════════════════════════════════════════════

# ── 数据库 ─────────────────────────────────────────────────────
# ⚠️ 填错库名的后果（三种，逐条写清）：
#   - 填成 faze_admin：Flyway 会把 app_user / law_item 建进 RuoYi 的库，
#     与 sys_user / sys_menu 等框架表混居；之后任何一次 flyway clean
#     都会连 RuoYi 的表一起清掉，后台直接登不进去。
#   - 填成生产库：本地的 V1、V2 迁移会写进真实业务库，等于线上被灌测试数据。
#   - 填成 faze_test：段 0 的库名守卫会拒绝启动（只允许 faze）。
FAZE_DB_URL=jdbc:mysql://127.0.0.1:3306/faze?useUnicode=true&characterEncoding=UTF-8&serverTimezone=UTC
FAZE_DB_USER=faze_app
# ⚠️ 必填，留空直接启动失败（不提供默认值）。不要填 root：
#    应用会用 root 的 CREATE/DROP/GRANT 权限跑迁移，一次写错 SQL 能清空整个实例。
FAZE_DB_PASSWORD=

# ── Redis ──────────────────────────────────────────────────────
# ⚠️ 填错库号的后果：/0 是默认库，本机其他项目也常用；
#    段 1 起“清缓存”会误删别人的 key。固定用独立的 /14。
FAZE_REDIS_URL=redis://127.0.0.1:6379/14
# 段 0 实测（2026-11-02）：本机 Redis = tporadowski 移植版 5.0.14.1（非 7.x，见 deploy/README.md）
# Windows 服务名（由 deploy/redis-faze.conf 注册）与客户端可执行文件
FAZE_REDIS_SERVICE=Redis
FAZE_REDIS_CLI=redis-cli
FAZE_REDIS_BIN=E:\Redis-x64-5.0.14.1

# ── 服务端口 ───────────────────────────────────────────────────
# ⚠️ 填成 8080 的后果：与 RuoYi 后端（vite proxy 目标 localhost:8080）撞车，
#    PC 后台登录会被转发到 faze-api，返回结构与 RuoYi 的 AjaxResult 不兼容。
FAZE_API_PORT=8081

# ── 第三方（留空即走 mock，不花钱、不调用真实服务）─────────────────
FAZE_DOUBAO_API_KEY=
FAZE_DOUBAO_BASE_URL=
