<?xml version="1.0" encoding="UTF-8"?>
<!--
  法泽 FAZE 服务端（段 0：可安装底座 + 三项探针）
  职责：R 统一响应 / 全局异常 / traceId / JWT 过滤器 / 审计四要素 / 三个探针 / 段 0 的 6 个接口
  数据来源：MySQL faze 库（Flyway V1 建表、V2 灌 5 条法条）；refresh token 轮换状态段 0 用进程内 Map
  注意事项：
    1. ORM 必须用 mybatis-plus-spring-boot4-starter（不是 -spring-boot3-，SB4 下会静默失效）
    2. 分页插件 PaginationInnerInterceptor 已拆到 mybatis-plus-jsqlparser，必须单独加，否则编译失败
    3. Flyway 10+ 把 MySQL 支持拆到 flyway-mysql，只加 flyway-core 会报 Unsupported Database
    4. 不含 spring-boot-starter-data-redis（段 0 服务端不使用 Redis，段 1 第一个分布式锁用例前迁入）
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <!-- 2026-11-02 复核：文档写的 4.0.10 在 central 不存在（4.0.x 最新为 4.0.9）。
         按「本地已有真 pom 的 4.0.x 最新版」取 4.0.6；与 RuoYi 发行版 4.0.3 同一大版本。 -->
    <version>4.0.6</version>
    <relativePath/>
  </parent>

  <groupId>com.faze</groupId>
  <artifactId>faze-api</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <name>faze-api</name>
  <description>法泽 FAZE 服务端（段 0）</description>

  <properties>
    <java.version>17</java.version>
    <mybatis-plus.version>3.5.18.1</mybatis-plus.version>
    <jjwt.version>0.12.3</jjwt.version>
    <lombok.version>1.18.38</lombok.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <!-- 2026-11-02 复核：SB 4.0 起没有 spring-boot-starter-aop（改为 spring-boot-starter-aspectj）。
         段 0 不做 AOP 审计（审计四要素只进 MDC/ThreadLocal，不写库）；
         段 1 A4 补建审计切面，故引入 aspectj starter（不是 aop starter，名字不同）。 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-aspectj</artifactId>
    </dependency>

    <!-- Redis：第 1 段 A2 引入（验证码、令牌、限流、支付密码锁定计数都依赖它）。
         逻辑库用 1，与 RuoYi 的 0 分开；业务 key 统一前缀 faze: -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>

    <!-- WebSocket：第 2 段 G6 的 IM 长连接（端点 /ws/chat）。
         理由：2-A2 要求消息 ≤2 秒、2-A9 要求断线 30 秒后重连补齐，轮询不满足这两个锚点；
         版本随 Boot 父 POM，不单独锁。登记见 docs/architecture/依赖清单.md。 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-websocket</artifactId>
    </dependency>

    <!-- WebFlux（只用 WebClient，不切响应式容器）：第 3 段 C1 的豆包 SSE 流式调用。
         理由：技术路线 §11.2 L2869 明确要求用 `WebClient`；阻塞式 RestClient 无法把
         `text/event-stream` 逐块交给 SseEmitter。项目已有 spring-boot-starter-web，
         Boot 会按 SERVLET 启动（webflux 只在 classpath 上提供 WebClient），不会变成 Reactive 应用。
         本段不用 RouterFunction / WebFilter。登记见 docs/architecture/依赖清单.md。 -->
    <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-webflux</artifactId>
    </dependency>

    <!-- MyBatis-Plus：SB4 starter + 分页插件（两个都要，版本一致） -->
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
      <version>${mybatis-plus.version}</version>
    </dependency>
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-jsqlparser</artifactId>
      <version>${mybatis-plus.version}</version>
    </dependency>

    <!-- MySQL 驱动：与 MySQL 8.0.44 服务端同代，不用 9.x -->
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <version>8.0.33</version>
      <scope>runtime</scope>
    </dependency>

    <!-- Flyway：SB 4 把自动配置拆成独立模块 spring-boot-flyway（只加 flyway-core 不会自动执行迁移，
         2026-11-02 实测：启动日志无迁移、库内 0 张表）；另 core + mysql 两个都要（只加 core 会报 Unsupported Database） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-mysql</artifactId>
    </dependency>

    <!-- HTML → PDF：段 4 文书渲染。
         它是 2023 年归档项目（最后版 1.0.10），不再有安全更新——锁死版本、不放宽，
         风险与退路（flying-saucer）见《第 4 段工作流》§六 R1。
         它内部传递 pdfbox 2.0.30，**不要另外声明 pdfbox 版本**，否则两条版本线打架
         （签名叠图、PDF 转 PNG、元数据读写都用这个传递进来的 2.0.x）。 -->
    <dependency>
      <groupId>com.openhtmltopdf</groupId>
      <artifactId>openhtmltopdf-pdfbox</artifactId>
      <version>1.0.10</version>
    </dependency>

    <!-- JWT：三件套都要 -->
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-api</artifactId>
      <version>${jjwt.version}</version>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-impl</artifactId>
      <version>${jjwt.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-jackson</artifactId>
      <version>${jjwt.version}</version>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Spring Boot 4 把 @AutoConfigureMockMvc 从 starter-test 拆到了 spring-boot-webmvc-test
         （包名也变了：org.springframework.boot.webmvc.test.autoconfigure）。
         不加这个依赖写 MockMvc 冒烟测试会找不到该注解。段 0 只此一处用途，已登记依赖清单。 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
            </exclude>
          </excludes>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
