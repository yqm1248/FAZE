<?xml version="1.0" encoding="UTF-8"?>
<!--
  法条检索 SQL（段 0 唯一自定义查询）
  职责：用 ngram 全文索引检索 law_item，返回命中行与相关度得分
  调用方：com.faze.infra.law.mapper.LawItemMapper#searchByNgram
  数据来源：MySQL faze.law_item（FULLTEXT KEY ft_law_content WITH PARSER ngram）
  注意事项：
    1. 全部参数用 #{}，禁用 ${}（后端规范 §7 硬规则）
    2. MATCH 必须两个地方都写：SELECT 里算得分、WHERE 里做过滤；只写一处会全表扫或得分恒 0
    3. 语序/词形不处理：ngram 按 2 字切词，单字查询必然 0 命中（实测），这是索引的语义不是 bug
    4. status/expire_date 过滤条件不能省：失效条文被 AI 引用会出事故
-->
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.faze.infra.law.mapper.LawItemMapper">

    <!--
      ngram 全文检索。
      返回 LawSearchRow：id / lawCode / articleNo / content / score
      说明：content 只用于生成摘要，出参不暴露全文（见 LawHitVO）
    -->
    <select id="searchByNgram" resultType="com.faze.infra.law.mapper.LawSearchRow">
        SELECT id,
               law_code                         AS lawCode,
               article_no                       AS articleNo,
               content,
               MATCH(content) AGAINST (#{kw})   AS score
        FROM law_item
        WHERE MATCH(content) AGAINST (#{kw})
          AND status = 'active'
          AND (expire_date IS NULL OR expire_date &gt; CURRENT_DATE)
        ORDER BY score DESC
        LIMIT #{limit}
    </select>

</mapper>
